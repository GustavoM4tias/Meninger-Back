        <td style="padding:16px 20px; color:#1e3a8a; font-size:14px; line-height:1.6;">
            {{{situacaoHtml}}}
        </td>
    </tr>
</table>

<p style="margin:0 0 12px 0; font-size:15px; color:#0f172a; line-height:1.6;">
