<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Cobrança do Ato - resumo de {{periodo}}</title>
<!--[if mso]><style>table,td,div,p,a,span{font-family:'Segoe UI',Arial,sans-serif !important;}</style><![endif]-->
</head>
<body style="margin:0;padding:0;background-color:#f1f5f9;">
<!-- Layout em tabelas de largura fixa: o Outlook do Windows desenha com o
     motor do Word e ignora max-width, border-radius, margem negativa e
     espaçamento de grade. Cor de fundo vai no atributo bgcolor. -->
<div style="display:none;max-height:0;overflow:hidden;mso-hide:all;">Pagos {{pagos.valor}} · a receber {{aReceber.valor}} · evasão {{evasao.pct}}</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f1f5f9" style="background-color:#f1f5f9;">
<tr><td align="center" style="padding:24px 12px;">

<table role="presentation" width="640" cellpadding="0" cellspacing="0" border="0" bgcolor="#ffffff" style="width:100%;max-width:640px;background-color:#ffffff;border:1px solid #e2e8f0;font-family:'Segoe UI',Arial,sans-serif;color:#0f172a;">

  <!-- Faixa do topo -->
  <tr><td bgcolor="#0f172a" style="background-color:#0f172a;padding:18px 28px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
      <td style="font-size:15px;font-weight:700;letter-spacing:3px;color:#ffffff;">MENIN</td>
      <td align="right" style="font-size:12px;color:#94a3b8;">Cobrança do Ato</td>
    </tr></table>
  </td></tr>

  <!-- Título -->
  <tr><td style="padding:28px 28px 8px 28px;">
    <div style="font-size:22px;font-weight:700;color:#0f172a;line-height:1.3;">Resumo da cobrança do ato</div>
    <div style="font-size:13px;color:#64748b;padding-top:6px;">Emitidos de {{periodo}} &nbsp;·&nbsp; posição de {{geradoEm}}</div>
  </td></tr>

  {{#if observacao}}
  <tr><td style="padding:16px 28px 0 28px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
      <td bgcolor="#f0f9ff" style="background-color:#f0f9ff;border-left:4px solid #0284c7;padding:12px 16px;font-size:14px;line-height:1.6;color:#0c4a6e;white-space:pre-wrap;">{{observacao}}</td>
    </tr></table>
  </td></tr>
  {{/if}}

  <!-- Indicadores: 2 x 2, com coluna vazia fazendo o espaço entre os cartões -->
  <tr><td style="padding:20px 28px 0 28px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
      <tr>
        <td width="48%" valign="top" bgcolor="#f8fafc" style="background-color:#f8fafc;border:1px solid #e2e8f0;border-top:4px solid #334155;padding:14px 16px;">
          <div style="font-size:11px;font-weight:700;color:#64748b;letter-spacing:1px;">EMITIDOS</div>
          <div style="font-size:24px;font-weight:700;color:#0f172a;padding-top:4px;">{{emitidos.valor}}</div>
          <div style="font-size:12px;color:#64748b;padding-top:2px;">{{emitidos.qty}} cobranças de ato</div>
        </td>
        <td width="4%" style="font-size:0;line-height:0;">&nbsp;</td>
        <td width="48%" valign="top" bgcolor="#f0fdf4" style="background-color:#f0fdf4;border:1px solid #bbf7d0;border-top:4px solid #16a34a;padding:14px 16px;">
          <div style="font-size:11px;font-weight:700;color:#15803d;letter-spacing:1px;">PAGOS</div>
          <div style="font-size:24px;font-weight:700;color:#14532d;padding-top:4px;">{{pagos.valor}}</div>
          <div style="font-size:12px;color:#15803d;padding-top:2px;">{{pagos.qty}} pagos &nbsp;·&nbsp; {{pagos.pct}} dos emitidos</div>
        </td>
      </tr>
      <tr><td colspan="3" style="font-size:0;line-height:0;height:12px;">&nbsp;</td></tr>
      <tr>
        <td width="48%" valign="top" bgcolor="#fffbeb" style="background-color:#fffbeb;border:1px solid #fde68a;border-top:4px solid #d97706;padding:14px 16px;">
          <div style="font-size:11px;font-weight:700;color:#b45309;letter-spacing:1px;">A RECEBER</div>
          <div style="font-size:24px;font-weight:700;color:#78350f;padding-top:4px;">{{aReceber.valor}}</div>
          <div style="font-size:12px;color:#b45309;padding-top:2px;">{{aReceber.qty}} em aberto</div>
          <div style="font-size:12px;color:#92400e;padding-top:8px;">A vencer: <b>{{aVencer.valor}}</b> ({{aVencer.qty}})</div>
          <div style="font-size:12px;color:#92400e;">Vencidos aguardando baixa: <b>{{vencidosAguardando.valor}}</b> ({{vencidosAguardando.qty}})</div>
        </td>
        <td width="4%" style="font-size:0;line-height:0;">&nbsp;</td>
        <td width="48%" valign="top" bgcolor="#fef2f2" style="background-color:#fef2f2;border:1px solid #fecaca;border-top:4px solid #dc2626;padding:14px 16px;">
          <div style="font-size:11px;font-weight:700;color:#b91c1c;letter-spacing:1px;">EVASÃO</div>
          <div style="font-size:24px;font-weight:700;color:#7f1d1d;padding-top:4px;">{{evasao.pct}}</div>
          <div style="font-size:12px;color:#b91c1c;padding-top:2px;">{{evasao.qty}} baixados sem pagamento</div>
          <div style="font-size:12px;color:#991b1b;padding-top:8px;">Valor: <b>{{evasao.valor}}</b></div>
        </td>
      </tr>
    </table>
  </td></tr>

  {{#if entradas}}
  <!-- Caixa do período -->
  <tr><td style="padding:16px 28px 0 28px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
      <td bgcolor="#f8fafc" style="background-color:#f8fafc;border:1px solid #e2e8f0;padding:12px 16px;font-size:13px;line-height:1.6;color:#334155;">
        <b style="color:#0f172a;">Entradas de caixa no período: {{entradas.valor}}</b> em {{entradas.qty}} atos pagos entre essas datas.
        {{#if entradas.foraDoPeriodo}}<br><span style="color:#64748b;">Inclui {{entradas.foraDoPeriodo}} emitidos antes do período ({{entradas.valorForaDoPeriodo}}).</span>{{/if}}
      </td>
    </tr></table>
  </td></tr>
  {{/if}}

  {{#if empreendimentos.length}}
  <!-- Por empreendimento -->
  <tr><td style="padding:28px 28px 0 28px;">
    <div style="font-size:12px;font-weight:700;color:#334155;letter-spacing:1px;padding-bottom:8px;">POR EMPREENDIMENTO</div>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="font-size:12px;color:#0f172a;">
      <tr bgcolor="#f1f5f9">
        <td style="background-color:#f1f5f9;padding:8px;font-weight:700;color:#475569;border-bottom:1px solid #cbd5e1;">Empreendimento</td>
        <td align="right" style="background-color:#f1f5f9;padding:8px;font-weight:700;color:#475569;border-bottom:1px solid #cbd5e1;">Emitido</td>
        <td align="right" style="background-color:#f1f5f9;padding:8px;font-weight:700;color:#475569;border-bottom:1px solid #cbd5e1;">Pago</td>
        <td align="right" style="background-color:#f1f5f9;padding:8px;font-weight:700;color:#475569;border-bottom:1px solid #cbd5e1;">A receber</td>
        <td align="right" style="background-color:#f1f5f9;padding:8px;font-weight:700;color:#475569;border-bottom:1px solid #cbd5e1;">Evasão</td>
      </tr>
      {{#each empreendimentos}}
      <tr>
        <td style="padding:8px;border-bottom:1px solid #e2e8f0;">{{nome}}</td>
        <td align="right" style="padding:8px;border-bottom:1px solid #e2e8f0;white-space:nowrap;">{{emitidos}}</td>
        <td align="right" style="padding:8px;border-bottom:1px solid #e2e8f0;white-space:nowrap;color:#15803d;">{{pagos}}</td>
        <td align="right" style="padding:8px;border-bottom:1px solid #e2e8f0;white-space:nowrap;color:#b45309;">{{pendente}}</td>
        <td align="right" style="padding:8px;border-bottom:1px solid #e2e8f0;white-space:nowrap;color:#b91c1c;">{{evasaoPct}}</td>
      </tr>
      {{/each}}
    </table>
  </td></tr>
  {{/if}}

  {{#if vencidos.length}}
  <!-- Vencidos sem pagamento -->
  <tr><td style="padding:28px 28px 0 28px;">
    <div style="font-size:12px;font-weight:700;color:#334155;letter-spacing:1px;padding-bottom:8px;">VENCIDOS AGUARDANDO BAIXA</div>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="font-size:12px;color:#0f172a;">
      <tr bgcolor="#f1f5f9">
        <td style="background-color:#f1f5f9;padding:8px;font-weight:700;color:#475569;border-bottom:1px solid #cbd5e1;">Reserva</td>
        <td style="background-color:#f1f5f9;padding:8px;font-weight:700;color:#475569;border-bottom:1px solid #cbd5e1;">Cliente</td>
        <td style="background-color:#f1f5f9;padding:8px;font-weight:700;color:#475569;border-bottom:1px solid #cbd5e1;">Empreendimento</td>
        <td align="right" style="background-color:#f1f5f9;padding:8px;font-weight:700;color:#475569;border-bottom:1px solid #cbd5e1;">Valor</td>
        <td align="right" style="background-color:#f1f5f9;padding:8px;font-weight:700;color:#475569;border-bottom:1px solid #cbd5e1;">Venc.</td>
      </tr>
      {{#each vencidos}}
      <tr>
        <td style="padding:8px;border-bottom:1px solid #e2e8f0;color:#64748b;white-space:nowrap;">#{{reserva}}</td>
        <td style="padding:8px;border-bottom:1px solid #e2e8f0;">{{titular}}</td>
        <td style="padding:8px;border-bottom:1px solid #e2e8f0;color:#64748b;">{{empreendimento}}</td>
        <td align="right" style="padding:8px;border-bottom:1px solid #e2e8f0;white-space:nowrap;">{{valor}}</td>
        <td align="right" style="padding:8px;border-bottom:1px solid #e2e8f0;white-space:nowrap;">{{vencimento}}</td>
      </tr>
      {{/each}}
    </table>
  </td></tr>
  {{/if}}

  {{#if erros.itens.length}}
  <!-- Não emitidos -->
  <tr><td style="padding:28px 28px 0 28px;">
    <div style="font-size:12px;font-weight:700;color:#334155;letter-spacing:1px;padding-bottom:8px;">NÃO EMITIDOS ({{erros.qty}} · {{erros.valor}})</div>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="font-size:12px;color:#0f172a;">
      {{#each erros.itens}}
      <tr>
        <td style="padding:8px;border-bottom:1px solid #e2e8f0;color:#64748b;white-space:nowrap;">#{{reserva}}</td>
        <td style="padding:8px;border-bottom:1px solid #e2e8f0;">{{titular}}<br><span style="color:#64748b;">{{motivo}}</span></td>
        <td align="right" style="padding:8px;border-bottom:1px solid #e2e8f0;white-space:nowrap;">{{valor}}</td>
      </tr>
      {{/each}}
    </table>
  </td></tr>
  {{/if}}

  <!-- Botão (tabela com bgcolor: o Outlook não desenha <a> como bloco) -->
  <tr><td style="padding:28px 28px 0 28px;">
    <table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr>
      <td bgcolor="#0f172a" style="background-color:#0f172a;padding:11px 20px;">
        <a href="{{link}}" style="color:#ffffff;text-decoration:none;font-size:13px;font-weight:700;">Abrir no Office &rarr;</a>
      </td>
    </tr></table>
  </td></tr>

  <!-- Como ler os números -->
  <tr><td style="padding:24px 28px 28px 28px;font-size:11px;line-height:1.6;color:#94a3b8;">
    Uma linha por reserva (a cobrança vigente). <b>Pago</b> = confirmado pela Caixa ou pela Rede.
    <b>A receber</b> = emitido e ainda sem pagamento; "vencido aguardando baixa" passou do vencimento e a Caixa
    ainda não devolveu. <b>Evasão</b> = baixado por falta de pagamento sobre o total emitido; reserva cancelada
    no CV não conta como evasão. Dados do Menin Office{{#if remetente}}, gerado por {{remetente}}{{/if}}.
  </td></tr>

</table>

</td></tr>
</table>
</body>
</html>
